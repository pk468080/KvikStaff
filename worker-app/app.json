{
  "expo": {
    "name": "KvikStaff Worker",
    "slug": "worker-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KvikStaff Worker needs your location to match you with nearby jobs while using the app.",
          "locationAlwaysAndWhenInUsePermission": "KvikStaff Worker uses background location only while you are marked Available or have an active booking, to support nearby job offers and customer live tracking during that booking.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "project": "worker-app",
          "organization": "KvikStaff"
        }
      ],
      "expo-splash-screen"
    ],
    "ios": {
      "bundleIdentifier": "com.princerajput.workerapp"
    },
    "android": {
      "package": "com.princerajput.workerapp",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "caf2c89e-2337-40c2-b962-dd34c394c174"
      }
    },
    "owner": "pk468080",
    "splash": {
      "image": "./assets/splash/splash_worker.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "icon": "./assets/image/Icon.png"
  }
}
