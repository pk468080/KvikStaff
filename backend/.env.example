APP_NAME=TempStaff API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Use your existing Supabase Postgres connection string.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
# Optional legacy HS256 signing secret. Prefer JWKS/asymmetric verification when available.
SUPABASE_JWT_SECRET=

REDIS_URL=redis://localhost:6379/0

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
