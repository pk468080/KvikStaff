APP_NAME=KvikStaff API
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Comma-separated production origins only.
CORS_ORIGINS=https://app.example.com,https://worker.example.com,https://admin.example.com

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1

# Leave empty when using JWKS/asymmetric verification.
SUPABASE_JWT_SECRET=

REDIS_URL=redis://:PASSWORD@HOST:6379/0

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=